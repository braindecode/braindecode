{# Presentation stays here; Python supplies the model and its checkpoint metadata. #}
<style>
.bd-model {font:13px/1.5 system-ui,sans-serif; max-width:880px; border:1px solid #8886; border-radius:8px; padding:12px; color:inherit}
.bd-model table {border-collapse:collapse; width:100%; text-align:left}
.bd-model th,.bd-model td {padding:3px 8px; border-bottom:1px solid #8883; text-align:left}
.bd-model caption {text-align:left; font-weight:600; font-size:16px}
.bd-model a {color:inherit; text-decoration:underline}
.bd-model .bd-chip {display:inline-block; border:1px solid #8886; border-radius:12px; padding:0 7px; margin:2px}
.bd-model .bd-loaded {background:#2ea04325}
.bd-model .bd-new {background:#d4820025}
.bd-model summary {cursor:pointer; padding-top:8px}
.bd-model pre {max-height:350px; overflow:auto; text-align:left}
</style>
<div class="bd-model">
<table>
  <caption>{{ name }}{% if data.source %} · checkpoint loaded{% endif %}</caption>
  <tr><th>Parameters</th><td>{{ '{:,}'.format(data.total) }}</td></tr>
  {% for label,value in data.geometry.items() %}
  <tr><th>{{ label }}</th><td>{{ value }}{% if label == 'sfreq' %} Hz{% endif %}</td></tr>
  {% endfor %}
  {% if data.source %}
  <tr><th>Weights</th><td>
    {% if data.source.local %}{{ data.source.repo_id }}
    {% else %}<a href="https://huggingface.co/{{ data.source.repo_id|urlencode }}" target="_blank" rel="noopener">{{ data.source.repo_id }}</a>
    {% set revision = data.source.commit or data.source.revision %}
    {% if revision %} @ <a href="https://huggingface.co/{{ data.source.repo_id|urlencode }}/tree/{{ revision|urlencode }}" target="_blank" rel="noopener">{{ revision[:7] }}</a>{% endif %}
    {% endif %}
  </td></tr>
  {% if model.card_data and model.card_data.license %}<tr><th>License</th><td>{{ model.card_data.license }}</td></tr>{% endif %}
  {% if model.card_data and model.card_data.base_model %}
  <tr><th>Base model</th><td>{{ model.card_data.base_model }}</td></tr>
  {% endif %}
  <tr><th>Trained on</th><td>
    {% for dataset in data.datasets %}
      {% if dataset[:2] in ['nm','on'] and dataset[2:].isdigit() and dataset|length == 8 %}
        {% set url = 'https://nemar.org/dataset/' ~ dataset %}
      {% elif dataset[:2] == 'ds' and dataset[2:].isdigit() and dataset|length == 8 %}
        {% set url = 'https://openneuro.org/datasets/' ~ dataset %}
      {% elif '/' in dataset %}
        {% set url = 'https://huggingface.co/datasets/' ~ dataset %}
      {% else %}{% set url = none %}{% endif %}
      {% if url %}<a class="bd-chip" href="{{ url }}" target="_blank" rel="noopener">{{ dataset }}</a>
      {% else %}<span class="bd-chip">{{ dataset }}</span>{% endif %}
    {% else %}Not listed on the model card{% endfor %}
  </td></tr>
  {% if data.source.supplementary %}
  <tr><th>Supplementary weights</th><td>{{ data.source.supplementary.repo_id }}</td></tr>
  {% endif %}
  {% if data.source.mixed %}<tr><th>Adapted tensors</th><td>{{ data.source.mixed|sort|join(', ') }} (excluded from the fully loaded count)</td></tr>{% endif %}
  <tr><th>Loaded parameters</th><td>{{ '{:,}'.format(data.loaded) }} / {{ '{:,}'.format(data.total) }} ({{ '%.1f'|format(data.percent) }}%)
    <progress value="{{ data.loaded }}" max="{{ data.total or 1 }}" aria-label="Parameters loaded from checkpoint"></progress>
  </td></tr>
  {% endif %}
</table>
{% if data.source %}
<details><summary>Parameter origin · {{ '%.1f'|format(data.percent) }}% of the parameters come from the checkpoint</summary>
<table>
  <thead><tr><th>Module</th><th>Type</th><th>Parameters</th><th>Origin</th></tr></thead>
  <tbody>{% for module,type,total,loaded in data.rows %}
  <tr class="{{ 'bd-loaded' if loaded == total else 'bd-new' }}">
    <td>{{ module }}</td><td>{{ type }}</td><td>{{ '{:,}'.format(total) }}</td>
    <td>{{ 'pretrained' if loaded == total else ('new or adapted' if not loaded else 'partly loaded') }}</td>
  </tr>{% endfor %}</tbody>
</table>
</details>
{% endif %}
<details><summary>Architecture</summary><pre>{{ architecture }}</pre></details>
</div>
